        <!-- Formulário de Triagem -->
        <section id="triagem" class="section-padding">
            <div class="container">
                <div style="max-width: 800px; margin: 0 auto; background: var(--bg-card); border: 1px solid var(--border-dark); border-radius: 8px; padding: 40px 32px;">
                    <div class="section-header-block text-center" style="margin-bottom: 32px;">
                        <h2>Solicitar Triagem Técnica de Caso</h2>
                        <p>Preencha os dados iniciais do caso para avaliação de viabilidade e enquadramento de faixa de valor. Resposta em até 24 horas úteis.</p>
                    </div>

                    <form id="form-triagem" name="triagem-juridica" method="POST" data-netlify="true" netlify-honeypot="bot-field" novalidate>
                        <input type="hidden" name="form-name" value="triagem-juridica" />
                        <p class="hidden" style="display:none;"><label>Não preencha: <input name="bot-field" /></label></p>
                        <div class="form-grid">
                            <div class="form-group">
                                <label for="nome_advogado">Nome do advogado ou profissional solicitante *</label>
                                <input type="text" id="nome_advogado" name="nome_advogado" required class="form-input">
                            </div>

                            <div class="form-group">
                                <label for="nome_escritorio">Nome do escritório ou organização</label>
                                <input type="text" id="nome_escritorio" name="nome_escritorio" class="form-input">
                            </div>

                            <div class="form-group full-width">
                                <label for="perfil_profissional">Qual é o seu perfil profissional? *</label>
                                <select id="perfil_profissional" name="perfil_profissional" required class="form-input">
                                    <option value="">Selecione uma opção</option>
                                    <option value="Sou advogado">Sou advogado</option>
                                    <option value="Represento um escritório de advocacia">Represento um escritório de advocacia</option>
                                    <option value="Represento um departamento jurídico">Represento um departamento jurídico</option>
                                    <option value="Sou profissional de apoio autorizado pelo advogado responsável">Sou profissional de apoio autorizado pelo advogado responsável</option>
                                    <option value="Outro">Outro</option>
                                </select>
                            </div>

                            <div class="form-group" id="group_oab">
                                <label for="inscricao_oab" id="label_oab">Inscrição OAB (UF/número) *</label>
                                <input type="text" id="inscricao_oab" name="inscricao_oab" required placeholder="Ex: MG/123456" class="form-input">
                            </div>

                            <div class="form-group">
                                <label for="whatsapp_contato">WhatsApp para contato *</label>
                                <input type="tel" id="whatsapp_contato" name="whatsapp_contato" required placeholder="(00) 00000-0000" class="form-input">
                            </div>

                            <div class="form-group full-width">
                                <label for="prazo_esperado">Prazo esperado para conclusão da demanda *</label>
                                <select id="prazo_esperado" name="prazo_esperado" required class="form-input">
                                    <option value="">Selecione o prazo desejado</option>
                                    <option value="Até 48 horas">Até 48 horas</option>
                                    <option value="De 3 a 5 dias úteis">De 3 a 5 dias úteis</option>
                                    <option value="De 6 a 8 dias úteis">De 6 a 8 dias úteis</option>
                                    <option value="De 9 a 12 dias úteis">De 9 a 12 dias úteis</option>
                                    <option value="Ainda não definido">Ainda não definido</option>
                                </select>
                            </div>

                            <div class="form-group full-width">
                                <label for="area_direito">Área do direito ou tema da demanda</label>
                                <input type="text" id="area_direito" name="area_direito" placeholder="Ex.: Cível, Empresarial, Tributário, Trabalhista ou Penal" class="form-input">
                            </div>

                            <div class="form-group full-width">
                                <label for="volume_documental">Estimativa de volume documental</label>
                                <textarea id="volume_documental" name="volume_documental" rows="3" placeholder="Páginas, volumes, peças da parte contrária, acórdãos etc." class="form-input"></textarea>
                            </div>

                            <div class="form-group full-width">
                                <label for="resumo_operacional">Resumo técnico / escopo pretendido</label>
                                <textarea id="resumo_operacional" name="resumo_operacional" rows="3" placeholder="Descreva somente o tipo de trabalho necessário, sem detalhes sigilosos." class="form-input"></textarea>
                            </div>
                        </div>

                        <!-- Checkbox Confirmação do Advogado -->
                        <div class="checkbox-group" style="margin-top: 16px;">
                            <input type="checkbox" id="confirmacao_advogado" name="confirmacao_advogado" required>
                            <label for="confirmacao_advogado">
                                Confirmo que a demanda será conduzida, revisada e juridicamente validada por advogado responsável. *
                            </label>
                        </div>

                        <!-- Checkbox LGPD / Privacidade -->
                        <div class="checkbox-group">
                            <input type="checkbox" id="lgpd_consent" name="lgpd_consent" required>
                            <label for="lgpd_consent">
                                Declaro que li a <a href="privacidade.html" target="_blank" style="color: var(--accent-gold); text-decoration: underline;">Política de Privacidade</a> e estou ciente do tratamento dos dados necessários para análise da solicitação, contato por WhatsApp e elaboração de eventual proposta técnica. *
                            </label>
                        </div>

                        <!-- Aviso antes do envio -->
                        <div class="form-warning-notice">
                            Este formulário destina-se apenas ao contato inicial e à triagem preliminar. Não envie autos, peças processuais, nomes das partes, números de processos sob sigilo ou dados pessoais sensíveis nesta etapa. O compartilhamento de documentos ocorrerá somente após a definição do escopo, a formalização da contratação e do acordo de confidencialidade, por canal definido com o contratante.
                        </div>

                        <div id="form-feedback" class="form-feedback-message" style="display: none;"></div>

                        <button type="submit" id="btn-submit-triagem" class="btn btn-gold btn-block" style="padding: 16px;">Solicitar triagem técnica</button>
                    </form>
                </div>
            </div>
        </section>
    </main>

    <!-- Botão Flutuante de WhatsApp -->
    <a href="https://wa.me/5531999314793?text=Ol%C3%A1%2C%20gostaria%20de%20informa%C3%A7%C3%B5es%20sobre%20o%20N%C3%BAcleo%20de%20Intelig%C3%AAncia%20Jur%C3%ADdica." 
       class="whatsapp-float" 
       id="whatsappFloat" 
       target="_blank" 
       rel="noopener noreferrer" 
       aria-label="Contato via WhatsApp">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="currentColor"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-1.007 3.676 3.75-1.009zm10.743-6.529c.145.242.223.518.223.8 0 .285-.084.561-.247.818-.466.733-1.44 1.282-2.152 1.282-.55 0-1.127-.22-1.994-.575-1.393-.571-2.868-1.579-4.041-2.752-1.173-1.173-2.181-2.648-2.752-4.041-.355-.867-.575-1.444-.575-1.994 0-.712.549-1.686 1.282-2.152.257-.163.533-.247.818-.247.282 0 .558.078.8.223l2.001 1.332c.264.176.4.475.34.787-.06.313-.274.571-.55.676l-.546.21c-.139.053-.257.147-.333.274-.145.242-.102.553.1.884.542.889 1.281 1.628 2.17 2.17.331.202.642.245.884.1.127-.076.221-.194.274-.333l.21-.546c.105-.276.363-.49.676-.55.312-.06.611.076.787.34l1.332 2.001z"/></svg>
    </a>

