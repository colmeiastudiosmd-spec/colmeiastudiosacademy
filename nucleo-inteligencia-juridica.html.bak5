    <!-- Scripts da Página -->
    <script>
    document.addEventListener("DOMContentLoaded", function() {

        // Acordeão do FAQ
        const faqTriggers = document.querySelectorAll(".faq-trigger");
        faqTriggers.forEach(function(trigger) {
            trigger.addEventListener("click", function() {
                const item = this.parentElement;
                const isExpanded = this.getAttribute("aria-expanded") === "true";
                
                // Fecha outros
                document.querySelectorAll(".faq-item").forEach(function(other) {
                    if(other !== item) {
                        other.classList.remove("active");
                        other.querySelector(".faq-trigger").setAttribute("aria-expanded", "false");
                    }
                });

                // Toggle atual
                item.classList.toggle("active");
                this.setAttribute("aria-expanded", (!isExpanded).toString());
            });
        });

        // Ocultar Botão de WhatsApp sobre o Formulário de Triagem
        const whatsappBtn = document.getElementById("whatsappFloat");
        const triagemSection = document.getElementById("triagem");

        if (whatsappBtn && triagemSection && "IntersectionObserver" in window) {
            const observer = new IntersectionObserver(function(entries) {
                entries.forEach(function(entry) {
                    if (entry.isIntersecting) {
                        whatsappBtn.classList.add("hidden");
                    } else {
                        whatsappBtn.classList.remove("hidden");
                    }
                });
            }, { threshold: 0.1 });

            observer.observe(triagemSection);
        }

        // Lógica Condicional do Campo OAB
        const perfilSelect = document.getElementById("perfil_profissional");
        const inputOab = document.getElementById("inscricao_oab");
        const labelOab = document.getElementById("label_oab");

        function updateOabField() {
            if (!perfilSelect || !inputOab || !labelOab) return;
            const val = perfilSelect.value;
            if (val === "Sou advogado") {
                labelOab.textContent = "Inscrição OAB — UF/número *";
                inputOab.required = true;
                inputOab.classList.remove("input-error");
            } else if (val === "Represento um escritório de advocacia") {
                labelOab.textContent = "Inscrição OAB do responsável pela demanda — UF/número *";
                inputOab.required = true;
                inputOab.classList.remove("input-error");
            } else {
                labelOab.textContent = "Inscrição OAB do advogado responsável, se disponível";
                inputOab.required = false;
                inputOab.classList.remove("input-error");
            }
        }

        if (perfilSelect) {
            perfilSelect.addEventListener("change", updateOabField);
            updateOabField();
        }

        // Validação e Envio do Formulário de Triagem para Netlify Forms
        const formTriagem = document.getElementById("form-triagem");
        if (formTriagem) {
            formTriagem.addEventListener("submit", function(e) {
                e.preventDefault();
                
                const feedbackEl = document.getElementById("form-feedback");
                const submitBtn = document.getElementById("btn-submit-triagem");
                
                function showOk() {
                    feedbackEl.style.display = "block";
                    feedbackEl.className = "form-feedback-message feedback-success";
                    feedbackEl.textContent = "Solicitação recebida. O contato será realizado pelo WhatsApp informado após a análise inicial das informações.";
                    formTriagem.reset();
                    submitBtn.disabled = false;
                }

                function showFail(msg) {
                    feedbackEl.style.display = "block";
                    feedbackEl.className = "form-feedback-message feedback-error";
                    feedbackEl.textContent = msg;
                    submitBtn.disabled = false;
                }

                const requiredFields = formTriagem.querySelectorAll("[required]");
                let isValid = true;
                
                requiredFields.forEach(function(field) {
                    if (field.type === "checkbox") {
                        if (!field.checked) {
                            isValid = false;
                        }
                    } else if (!field.value.trim()) {
                        isValid = false;
                        field.classList.add("input-error");
                    } else {
                        field.classList.remove("input-error");
                    }
                });

                if (!isValid) {
                    showFail("Por favor, preencha todos os campos obrigatórios (*) e confirme a leitura da Política de Privacidade.");
                    return;
                }

                submitBtn.disabled = true;

                const formData = new FormData(formTriagem);
                if (!formData.get("form-name")) {
                    formData.set("form-name", "triagem-juridica");
                }

                fetch(window.location.pathname || "/", {
                    method: "POST",
                    headers: { "Content-Type": "application/x-www-form-urlencoded" },
                    body: new URLSearchParams(formData).toString()
                })
                .then(function(res) {
                    if (res.ok) {
                        showOk();
                    } else {
                        console.error("Erro na resposta do Netlify:", res.statusText);
                        showFail("Erro no envio. Por favor, tente novamente ou entre em contato via WhatsApp.");
                    }
                })
                .catch(function(err) {
                    console.error("Falha no envio:", err);
                    showFail("Erro de conexão. Por favor, tente novamente ou entre em contato diretamente pelo WhatsApp.");
                });
            });
        }

        // Lógica do Menu Mobile Responsivo & Acessível
        const menuToggleBtn = document.getElementById("mobile-menu-toggle");
        const navMenu = document.getElementById("mobile-navigation");

        if (menuToggleBtn && navMenu) {
            function openMenu() {
                navMenu.classList.add("is-open");
                menuToggleBtn.setAttribute("aria-expanded", "true");
                menuToggleBtn.setAttribute("aria-label", "Fechar menu de navegação");
            }

            function closeMenu(focusToggle) {
                if (!navMenu.classList.contains("is-open")) return;
                navMenu.classList.remove("is-open");
                menuToggleBtn.setAttribute("aria-expanded", "false");
                menuToggleBtn.setAttribute("aria-label", "Abrir menu de navegação");
                if (focusToggle) {
                    menuToggleBtn.focus();
                }
            }

            menuToggleBtn.addEventListener("click", function(e) {
                e.stopPropagation();
                const isOpen = navMenu.classList.contains("is-open");
                if (isOpen) {
                    closeMenu(false);
                } else {
                    openMenu();
                }
            });

            // Fechar ao clicar em qualquer link do menu
            const menuNavLinks = navMenu.querySelectorAll("a");
            menuNavLinks.forEach(function(link) {
                link.addEventListener("click", function() {
                    closeMenu(false);
                });
            });

            // Fechar ao clicar fora do cabeçalho / menu
            document.addEventListener("click", function(e) {
                if (navMenu.classList.contains("is-open")) {
                    const isClickInsideMenu = navMenu.contains(e.target);
                    const isClickOnToggle = menuToggleBtn.contains(e.target);
                    if (!isClickInsideMenu && !isClickOnToggle) {
                        closeMenu(false);
                    }
                }
            });

            // Fechar ao pressionar a tecla Escape
            document.addEventListener("keydown", function(e) {
                if (e.key === "Escape" || e.key === "Esc") {
                    if (navMenu.classList.contains("is-open")) {
                        closeMenu(true);
                    }
                }
            });

            // Fechar ao redimensionar para 992px ou mais
            window.addEventListener("resize", function() {
                if (window.innerWidth >= 992 && navMenu.classList.contains("is-open")) {
                    closeMenu(false);
                }
            });
        }
    });
    </script>
</body>
</html>
