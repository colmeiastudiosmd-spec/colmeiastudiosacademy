        <!-- Valores de Referência por Demanda -->
        <section id="valores" class="section-padding bg-alt">
            <div class="container">
                <div class="section-header-block">
                    <h2>Valores de Referência por Demanda</h2>
                    <p>Preços orientativos baseados na complexidade documental e no volume de pesquisa do caso.</p>
                </div>

                <div class="pricing-table-wrapper">
                    <table class="pricing-table">
                        <thead>
                            <tr>
                                <th>Faixa de Demanda</th>
                                <th>Critérios do Caso</th>
                                <th>Prazo Padrão</th>
                                <th>Valor de Referência</th>
                                <th>Revisões Incluídas</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td data-label="Faixa" style="font-weight: 700; color: #ffffff;">Essencial</td>
                                <td data-label="Critérios">Pesquisa pontual de precedentes; organização de autos curtos; minuta simples de apoio</td>
                                <td data-label="Prazo de entrega">Até 5 dias úteis</td>
                                <td data-label="Valor de referência" style="color: var(--accent-gold); font-weight: 700;">R$ 1.800 a R$ 2.800</td>
                                <td data-label="Revisões">1</td>
                            </tr>
                            <tr>
                                <td data-label="Faixa" style="font-weight: 700; color: #ffffff;">Padrão (Assistência Completa)</td>
                                <td data-label="Critérios">Pesquisa aprofundada de jurisprudência; contraposição de teses; autos de média complexidade; 1 manifestação contrária a rebater</td>
                                <td data-label="Prazo de entrega">Até 8 dias úteis</td>
                                <td data-label="Valor de referência" style="color: var(--accent-gold); font-weight: 700;">R$ 4.000 a R$ 6.500</td>
                                <td data-label="Revisões">2</td>
                            </tr>
                            <tr>
                                <td data-label="Faixa" style="font-weight: 700; color: #ffffff;">Complexa / Tribunais Superiores</td>
                                <td data-label="Critérios">Múltiplos volumes, laudos técnicos complexos, divergência jurisprudencial consolidada, tribunais superiores</td>
                                <td data-label="Prazo de entrega">Até 12 dias úteis</td>
                                <td data-label="Valor de referência" style="color: var(--accent-gold); font-weight: 700;">R$ 7.000 a R$ 12.000</td>
                                <td data-label="Revisões">2 a 3</td>
                            </tr>
                        </tbody>
